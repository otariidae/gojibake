{
  "name": "gojibake",
  "private": true,
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter '*' build",
    "build:packages": "bun --filter './packages/*' build",
    "dev": "bun run build:packages && bun --filter gojibake-site dev",
    "test": "bun --filter '*' --if-present test && bun run test:scripts",
    "test:scripts": "bun test ./.github/scripts/*.test.ts",
    "test:coverage": "bun --filter '*' --if-present test:coverage",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "biome lint .",
    "check:fix": "bun run format && biome lint --write . && bun run format",
    "check": "bun run format:check && bun run lint && bun run build && bun run typecheck && bun run test",
    "typecheck": "bun run build:packages && bun --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@happy-dom/global-registrator": "^20.8.9",
    "happy-dom": "^20.8.9",
    "typescript": "7.0.2"
  }
}
